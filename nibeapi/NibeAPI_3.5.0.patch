diff --git a/nibeapi/selections.php b/nibeapi/selections.php
new file mode 100644
index 0000000..253c60f
--- /dev/null
+++ b/nibeapi/selections.php
@@ -0,0 +1,156 @@
+<?php
+/**
+ * Gespeicherte Datenpunkt-Auswahlen + automatische Schema-Installation
+ * selections.php v3.5.0
+ *
+ * Eine Auswahl gehört zu einem Device (die API-IDs unterscheiden sich je nach
+ * Gerätetyp) und besteht aus einem Namen und einer Liste von API-IDs.
+ */
+
+/**
+ * Legt fehlende Tabellen der Version 3.5.0 an (db_update_3.5.0.sql).
+ * Läuft pro Request höchstens einmal und prüft vorher mit einer billigen Abfrage.
+ */
+function ensureExtensionTables() {
+    static $done = false;
+    if ($done) {
+        return;
+    }
+    $done = true;
+
+    $pdo = getDbConnection();
+
+    $needed = ['nibe_auswahl', 'nibe_auswahl_punkte', 'nibe_regeln',
+               'nibe_regel_bedingungen', 'nibe_regel_aktionen', 'nibe_regel_log'];
+    $existing = $pdo->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);
+    if (!array_diff($needed, $existing)) {
+        return;
+    }
+
+    $file = __DIR__ . '/db_update_3.5.0.sql';
+    if (!is_readable($file)) {
+        throw new Exception('db_update_3.5.0.sql nicht gefunden - Tabellen können nicht angelegt werden');
+    }
+
+    // Kommentarzeilen entfernen, dann an ; trennen
+    $lines = [];
+    foreach (preg_split('/\R/', file_get_contents($file)) as $line) {
+        if (preg_match('/^\s*--/', $line)) {
+            continue;
+        }
+        $lines[] = $line;
+    }
+    foreach (explode(';', implode("\n", $lines)) as $stmt) {
+        $stmt = trim($stmt);
+        if ($stmt !== '') {
+            $pdo->exec($stmt);
+        }
+    }
+    debugLog('Tabellen der Version 3.5.0 angelegt', null, 'DB');
+}
+
+/**
+ * Alle Auswahlen eines Devices (mit Anzahl der Datenpunkte)
+ */
+function getSelections($deviceId) {
+    ensureExtensionTables();
+    $pdo = getDbConnection();
+    $stmt = $pdo->prepare("
+        SELECT a.id, a.name, a.deviceId, a.updated_at, COUNT(p.api_id) AS anzahl
+        FROM nibe_auswahl a
+        LEFT JOIN nibe_auswahl_punkte p ON p.auswahl_id = a.id
+        WHERE a.deviceId = ?
+        GROUP BY a.id, a.name, a.deviceId, a.updated_at
+        ORDER BY a.name ASC
+    ");
+    $stmt->execute([(int)$deviceId]);
+    return $stmt->fetchAll();
+}
+
+/**
+ * Eine Auswahl inkl. API-IDs
+ */
+function getSelection($id) {
+    ensureExtensionTables();
+    $pdo = getDbConnection();
+    $stmt = $pdo->prepare("SELECT id, name, deviceId, updated_at FROM nibe_auswahl WHERE id = ?");
+    $stmt->execute([(int)$id]);
+    $sel = $stmt->fetch();
+    if (!$sel) {
+        return null;
+    }
+    $stmt = $pdo->prepare("SELECT api_id FROM nibe_auswahl_punkte WHERE auswahl_id = ? ORDER BY api_id");
+    $stmt->execute([(int)$id]);
+    $sel['apiIds'] = array_map('intval', $stmt->fetchAll(PDO::FETCH_COLUMN));
+    return $sel;
+}
+
+/**
+ * Auswahl anlegen ($id = null) oder aktualisieren.
+ * $apiIds = null lässt die Punkte unverändert (nur umbenennen).
+ * Gibt die ID zurück.
+ */
+function saveSelection($id, $name, $deviceId, $apiIds = null) {
+    ensureExtensionTables();
+
+    $name = trim((string)$name);
+    if ($name === '') {
+        throw new Exception('Bitte einen Namen angeben');
+    }
+    if (mb_strlen($name) > 100) {
+        throw new Exception('Der Name darf höchstens 100 Zeichen lang sein');
+    }
+
+    $pdo = getDbConnection();
+    $deviceId = (int)$deviceId;
+
+    // Namen eindeutig pro Device
+    $stmt = $pdo->prepare("SELECT id FROM nibe_auswahl WHERE deviceId = ? AND name = ? AND id <> ?");
+    $stmt->execute([$deviceId, $name, (int)$id]);
+    if ($stmt->fetch()) {
+        throw new Exception("Es gibt bereits eine Auswahl mit dem Namen \"$name\"");
+    }
+
+    $pdo->beginTransaction();
+    try {
+        if ($id) {
+            $stmt = $pdo->prepare("UPDATE nibe_auswahl SET name = ?, updated_at = NOW() WHERE id = ?");
+            $stmt->execute([$name, (int)$id]);
+            $stmt = $pdo->prepare("SELECT id FROM nibe_auswahl WHERE id = ?");
+            $stmt->execute([(int)$id]);
+            if (!$stmt->fetch()) {
+                throw new Exception('Auswahl nicht gefunden');
+            }
+        } else {
+            $stmt = $pdo->prepare("INSERT INTO nibe_auswahl (deviceId, name) VALUES (?, ?)");
+            $stmt->execute([$deviceId, $name]);
+            $id = (int)$pdo->lastInsertId();
+        }
+
+        if (is_array($apiIds)) {
+            $pdo->prepare("DELETE FROM nibe_auswahl_punkte WHERE auswahl_id = ?")->execute([(int)$id]);
+            $ins = $pdo->prepare("INSERT IGNORE INTO nibe_auswahl_punkte (auswahl_id, api_id) VALUES (?, ?)");
+            foreach (array_unique(array_map('intval', $apiIds)) as $apiId) {
+                $ins->execute([(int)$id, $apiId]);
+            }
+        }
+        $pdo->commit();
+    } catch (Exception $e) {
+        $pdo->rollBack();
+        throw $e;
+    }
+
+    return (int)$id;
+}
+
+/**
+ * Auswahl löschen (die Punkte werden per ON DELETE CASCADE entfernt)
+ */
+function deleteSelection($id) {
+    ensureExtensionTables();
+    $pdo = getDbConnection();
+    $stmt = $pdo->prepare("DELETE FROM nibe_auswahl WHERE id = ?");
+    $stmt->execute([(int)$id]);
+    return $stmt->rowCount() > 0;
+}
+?>
diff --git a/nibeapi/steuerung.php b/nibeapi/steuerung.php
new file mode 100644
index 0000000..0786cac
--- /dev/null
+++ b/nibeapi/steuerung.php
@@ -0,0 +1,199 @@
+<?php
+/**
+ * Steuerung: Regeln mit Zeitfenster, Wochentagen, Bedingungen und Aktionen
+ * steuerung.php v3.5.0
+ *
+ * Die Regeln werden hier gepflegt und vom Cronjob control-cron.php ausgeführt.
+ */
+
+header('Content-Type: text/html; charset=utf-8');
+mb_internal_encoding('UTF-8');
+
+require_once 'config.php';
+require_once 'functions.php';
+require_once 'database.php';
+
+// AJAX-Requests verarbeiten (beendet die Ausführung wenn AJAX)
+require_once 'ajax-handlers.php';
+
+if (!USE_DB) {
+    die('Die Steuerung benötigt die Datenbank. Bitte USE_DB in der config.php aktivieren.');
+}
+
+$version = '3.5.0';
+$backDeviceId = isset($_GET['deviceId']) ? (int)$_GET['deviceId'] : 0;
+$cronCommand = '* * * * * /usr/bin/php ' . __DIR__ . '/control-cron.php >/dev/null 2>&1';
+?>
+<!DOCTYPE html>
+<html lang="de">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Nibe Steuerung <?php echo $version; ?></title>
+    <link rel="stylesheet" href="assets/styles.css">
+    <link rel="stylesheet" href="assets/steuerung.css">
+</head>
+<body>
+<div class="container ctl-container">
+    <div class="header-actions">
+        <h1>⚙️ Steuerung <?php echo $version; ?></h1>
+        <button class="btn-reset" onclick="window.location.href='index.php?deviceId=<?php echo $backDeviceId; ?>'">← Zurück zur Übersicht</button>
+    </div>
+
+    <div id="ctlStatus" class="ctl-status"></div>
+
+    <div class="ctl-tabs" role="tablist">
+        <button type="button" class="ctl-tab active" data-tab="rules">📋 Regeln</button>
+        <button type="button" class="ctl-tab" data-tab="log">📜 Protokoll</button>
+        <button type="button" class="ctl-tab" data-tab="help">❓ Hilfe</button>
+    </div>
+
+    <!-- ===================== Regeln ===================== -->
+    <section id="tab-rules" class="ctl-section">
+        <div class="ctl-toolbar">
+            <button type="button" class="ctl-btn ctl-btn-primary" id="btnNewRule">➕ Neue Regel</button>
+            <button type="button" class="ctl-btn" id="btnPreview">🔍 Live prüfen</button>
+            <span class="ctl-muted" id="previewInfo">Es wird nichts gesendet, nur gelesen und ausgewertet.</span>
+        </div>
+        <div id="ruleList"><div class="ctl-empty">Lade Regeln…</div></div>
+    </section>
+
+    <!-- ===================== Protokoll ===================== -->
+    <section id="tab-log" class="ctl-section" hidden>
+        <div class="ctl-toolbar">
+            <label for="logRule">Regel:</label>
+            <select id="logRule"><option value="0">Alle</option></select>
+            <label class="ctl-check"><input type="checkbox" id="logOnlyEvents" checked> Zweigwechsel ausblenden</label>
+            <button type="button" class="ctl-btn" id="btnReloadLog">🔄 Aktualisieren</button>
+        </div>
+        <div class="ctl-table-wrap">
+            <table class="ctl-table" id="logTable">
+                <thead><tr>
+                    <th>Zeit</th><th>Regel</th><th>Zweig</th><th>Datenpunkt</th><th>Wert</th><th>Status</th><th>Meldung</th>
+                </tr></thead>
+                <tbody></tbody>
+            </table>
+        </div>
+    </section>
+
+    <!-- ===================== Hilfe ===================== -->
+    <section id="tab-help" class="ctl-section" hidden>
+        <div class="ctl-help">
+            <h3>So arbeitet die Steuerung</h3>
+            <p>Der Cronjob <code>control-cron.php</code> läuft jede Minute und wertet alle aktiven Regeln aus. Ein Wert wird <strong>nur gesendet, wenn er vom Zielwert abweicht</strong>.</p>
+            <pre><?php echo htmlspecialchars($cronCommand); ?></pre>
+
+            <h3>Aufbau einer Regel</h3>
+            <ol>
+                <li><strong>Zeitfenster:</strong> Wochentage und Uhrzeit von–bis. Ist „von“ später als „bis“ (z. B. 22:00–06:00), geht das Fenster über Mitternacht; der Wochentag gilt für den Tag, an dem das Fenster beginnt. „von = bis“ bedeutet ganztägig.</li>
+                <li><strong>WENN:</strong> Bedingungen auf beliebige Datenpunkte (auch anderer Geräte) mit &lt;, ≤, =, ≥, &gt;, ≠. <strong>UND bindet stärker als ODER.</strong> Ohne Bedingung gilt die Regel im ganzen Zeitfenster.</li>
+                <li><strong>DANN:</strong> Datenpunkte, die gesetzt werden, wenn die Bedingung wahr ist.</li>
+                <li><strong>SONST:</strong> optional, wird gesetzt, wenn die Bedingung falsch ist. Mit „Außerhalb des Zeitfensters“ kann der SONST-Zweig auch dann gelten, wenn das Zeitfenster nicht aktiv ist.</li>
+            </ol>
+
+            <h3>Damit nichts ständig hin- und herschaltet</h3>
+            <ul>
+                <li><strong>Hysterese</strong> (je Bedingung): Ist die Regel im DANN-Zweig, bleibt die Bedingung um diesen Betrag länger wahr. Beispiel: <code>Gradminuten &lt; −200</code> mit Hysterese 50 schaltet bei −200 ein und erst über −150 wieder aus.</li>
+                <li><strong>Mindest-Haltezeit:</strong> Mindestdauer in Minuten, bevor die Regel zwischen DANN und SONST wechseln darf.</li>
+                <li><strong>Erneutes Senden:</strong> Nimmt die Anlage einen Wert nicht an, wird er frühestens nach <code>CONTROL_RESEND_MINUTES</code> (config.php) erneut gesendet.</li>
+            </ul>
+
+            <h3>Mehrere Regeln</h3>
+            <p>Regeln werden nach <strong>Priorität</strong> (kleinere Zahl = wichtiger) ausgewertet. Zielt eine Regel auf einen Datenpunkt, den eine wichtigere Regel gerade setzt, wird sie für diesen Datenpunkt übersteuert.</p>
+
+            <h3>Sicherheit</h3>
+            <ul>
+                <li>Kann ein Datenpunkt nicht gelesen werden (Gerät offline), tut die Regel <strong>nichts</strong>.</li>
+                <li>Zielwerte außerhalb des erlaubten Bereichs der Anlage werden nicht gesendet.</li>
+                <li>Alle Werte werden in der <strong>Anzeigeeinheit</strong> angegeben (z. B. 45,5 °C, nicht 455).</li>
+                <li>Testen ohne zu senden: <code>php control-cron.php --dry-run</code></li>
+            </ul>
+        </div>
+    </section>
+</div>
+
+<!-- ===================== Regel-Editor ===================== -->
+<div class="edit-modal" id="ruleModal">
+    <div class="edit-content ctl-modal-content">
+        <div class="edit-header">
+            <h2 id="ruleModalTitle">Regel</h2>
+        </div>
+
+        <div class="ctl-form">
+            <div class="ctl-grid">
+                <div class="ctl-field ctl-grow">
+                    <label for="fName">Name</label>
+                    <input type="text" id="fName" maxlength="100" placeholder="z. B. S135 Nachtunterstützung">
+                </div>
+                <div class="ctl-field">
+                    <label for="fPrio" title="Kleinere Zahl = wichtiger">Priorität</label>
+                    <input type="number" id="fPrio" value="100" step="1">
+                </div>
+                <div class="ctl-field ctl-check-field">
+                    <label class="ctl-check"><input type="checkbox" id="fAktiv" checked> Regel aktiv</label>
+                </div>
+            </div>
+            <div class="ctl-field">
+                <label for="fBeschreibung">Beschreibung (optional)</label>
+                <input type="text" id="fBeschreibung" maxlength="255">
+            </div>
+
+            <fieldset class="ctl-box">
+                <legend>🕒 Wann</legend>
+                <div class="ctl-days" id="fDays"></div>
+                <div class="ctl-grid">
+                    <div class="ctl-field">
+                        <label for="fVon">von</label>
+                        <input type="time" id="fVon" value="00:00">
+                    </div>
+                    <div class="ctl-field">
+                        <label for="fBis">bis</label>
+                        <input type="time" id="fBis" value="00:00">
+                    </div>
+                    <div class="ctl-field">
+                        <label for="fHalte" title="Mindestdauer, bevor zwischen DANN und SONST gewechselt werden darf">Mindest-Haltezeit (Min.)</label>
+                        <input type="number" id="fHalte" min="0" max="1440" value="0">
+                    </div>
+                    <div class="ctl-field ctl-grow">
+                        <label for="fAusserhalb">Außerhalb des Zeitfensters</label>
+                        <select id="fAusserhalb">
+                            <option value="nichts">nichts tun</option>
+                            <option value="sonst">SONST-Aktionen ausführen</option>
+                        </select>
+                    </div>
+                </div>
+                <div class="ctl-muted">von = bis bedeutet ganztägig. von &gt; bis geht über Mitternacht (z. B. 22:00–06:00).</div>
+            </fieldset>
+
+            <fieldset class="ctl-box">
+                <legend>❓ WENN <span class="ctl-muted">(leer = immer wahr · UND vor ODER)</span></legend>
+                <div id="condRows"></div>
+                <button type="button" class="ctl-btn ctl-btn-small" id="btnAddCond">➕ Bedingung</button>
+            </fieldset>
+
+            <fieldset class="ctl-box ctl-box-then">
+                <legend>✅ DANN setze</legend>
+                <div id="thenRows"></div>
+                <button type="button" class="ctl-btn ctl-btn-small" data-add-action="dann">➕ Aktion</button>
+            </fieldset>
+
+            <fieldset class="ctl-box ctl-box-else">
+                <legend>↩️ SONST setze <span class="ctl-muted">(optional)</span></legend>
+                <div id="elseRows"></div>
+                <button type="button" class="ctl-btn ctl-btn-small" data-add-action="sonst">➕ Aktion</button>
+            </fieldset>
+
+            <div class="ctl-error" id="ruleError" hidden></div>
+            <div class="edit-buttons">
+                <button type="button" class="btn-edit-save" id="btnSaveRule">💾 Speichern</button>
+                <button type="button" class="btn-edit-cancel" id="btnCancelRule">✖ Abbrechen</button>
+            </div>
+        </div>
+    </div>
+</div>
+
+<div id="ctlDatalists"></div>
+
+<script src="assets/steuerung.js"></script>
+</body>
+</html>
diff --git a/tests/mock-nibe-api.php b/tests/mock-nibe-api.php
new file mode 100644
index 0000000..88fe11f
--- /dev/null
+++ b/tests/mock-nibe-api.php
@@ -0,0 +1,117 @@
+<?php
+/**
+ * Minimale Nibe-REST-API-Attrappe zum Testen ohne Wärmepumpe.
+ *   php -S 127.0.0.1:8443 tests/mock-nibe-api.php
+ * Der Zustand liegt in tests/mock-state.json; Schreibzugriffe (PATCH) landen
+ * in tests/mock-writes.log.
+ */
+$stateFile = __DIR__ . '/mock-state.json';
+$logFile = __DIR__ . '/mock-writes.log';
+
+function mockDefaults() {
+    // [apiId => [title, raw, divisor, decimal, unit, writable, min, max]]
+    return [
+        0 => [   // "S2125"
+            4    => ['Außentemperatur', -50, 10, 1, '°C', false, 0, 0],
+            781  => ['Gradminuten', -3000, 10, 0, 'GM', true, -30000, 30000],
+            5001 => ['Betriebsmodus', 0, 1, 0, '', true, -1, 5],
+            5002 => ['Heizkurve', 7, 1, 0, '', true, 1, 15],
+        ],
+        1 => [   // "S135"
+            6001 => ['Betriebsmodus', 0, 1, 0, '', true, -1, 5],
+            6002 => ['Vorlauftemperatur', 350, 10, 1, '°C', false, 0, 0],
+        ],
+    ];
+}
+
+$state = is_file($stateFile) ? json_decode(file_get_contents($stateFile), true) : null;
+if (!$state) {
+    $state = mockDefaults();
+    file_put_contents($stateFile, json_encode($state));
+}
+
+$path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
+header('Content-Type: application/json');
+
+// Testhilfe: POST /mock/set?device=0&id=781&raw=-500
+if ($path === '/mock/set') {
+    $state[(int)$_GET['device']][(int)$_GET['id']][1] = (int)$_GET['raw'];
+    file_put_contents($stateFile, json_encode($state));
+    echo '{"ok":true}';
+    return;
+}
+if ($path === '/mock/reset') {
+    @unlink($stateFile);
+    @unlink($logFile);
+    echo '{"ok":true}';
+    return;
+}
+// Testhilfe: Ausfall eines Geräts simulieren
+if ($path === '/mock/fail') {
+    file_put_contents(__DIR__ . '/mock-fail', (string)(int)$_GET['device']);
+    echo '{"ok":true}';
+    return;
+}
+if ($path === '/mock/ok') {
+    @unlink(__DIR__ . '/mock-fail');
+    echo '{"ok":true}';
+    return;
+}
+
+if ($path === '/api/v1/devices') {
+    echo json_encode(['devices' => [
+        ['deviceIndex' => 0, 'aidMode' => 'off', 'smartMode' => 'normal',
+         'product' => ['serialNumber' => 'S2125-0001', 'name' => 'S2125', 'manufacturer' => 'NIBE', 'firmwareId' => 'fw1']],
+        ['deviceIndex' => 1, 'aidMode' => 'off', 'smartMode' => 'normal',
+         'product' => ['serialNumber' => 'S135-0001', 'name' => 'S135', 'manufacturer' => 'NIBE', 'firmwareId' => 'fw1']],
+    ]]);
+    return;
+}
+
+if (preg_match('#^/api/v1/devices/(\d+)/points$#', $path, $m)) {
+    $dev = (int)$m[1];
+    if (is_file(__DIR__ . '/mock-fail') && (int)file_get_contents(__DIR__ . '/mock-fail') === $dev) {
+        http_response_code(503);
+        echo '{"error":"device offline"}';
+        return;
+    }
+    if (!isset($state[$dev])) {
+        http_response_code(404);
+        return;
+    }
+    if ($_SERVER['REQUEST_METHOD'] === 'PATCH') {
+        $body = json_decode(file_get_contents('php://input'), true);
+        foreach ($body as $item) {
+            $id = (int)$item['variableId'];
+            if (!isset($state[$dev][$id]) || !$state[$dev][$id][5]) {
+                http_response_code(400);
+                echo '{"error":"not writable"}';
+                return;
+            }
+            $state[$dev][$id][1] = (int)$item['integerValue'];
+            file_put_contents($logFile, date('H:i:s') . " dev=$dev id=$id raw={$item['integerValue']}\n", FILE_APPEND);
+        }
+        file_put_contents($stateFile, json_encode($state));
+        echo '{}';
+        return;
+    }
+    $out = [];
+    foreach ($state[$dev] as $id => [$title, $raw, $div, $dec, $unit, $writable, $min, $max]) {
+        $out[(string)$id] = [
+            'title' => $title,
+            'description' => '',
+            'value' => ['type' => 'datavalue', 'isOk' => true, 'variableId' => $id, 'integerValue' => $raw, 'stringValue' => ''],
+            'metadata' => [
+                'variableId' => $id, 'modbusRegisterID' => $id, 'divisor' => $div, 'decimal' => $dec,
+                'unit' => $unit, 'isWritable' => $writable, 'minValue' => $min, 'maxValue' => $max,
+                'modbusRegisterType' => $writable ? 'MODBUS_HOLDING_REGISTER' : 'MODBUS_INPUT_REGISTER',
+                'variableType' => 'integer', 'variableSize' => 's16',
+            ],
+        ];
+    }
+    echo json_encode($out);
+    return;
+}
+
+http_response_code(404);
+echo '{"error":"unknown route"}';
diff --git a/tests/test-control.php b/tests/test-control.php
new file mode 100644
index 0000000..76dad0b
--- /dev/null
+++ b/tests/test-control.php
@@ -0,0 +1,264 @@
+<?php
+/**
+ * Integrationstest der Steuerung gegen die Mock-API und eine echte MariaDB.
+ *   php -S 127.0.0.1:8443 tests/mock-nibe-api.php &
+ *   php tests/test-control.php
+ * ACHTUNG: leert die Tabellen nibe_regeln*, nibe_auswahl* der konfigurierten Datenbank!
+ */
+require_once __DIR__ . '/../nibeapi/config.php';
+require_once __DIR__ . '/../nibeapi/functions.php';
+require_once __DIR__ . '/../nibeapi/database.php';
+require_once __DIR__ . '/../nibeapi/selections.php';
+require_once __DIR__ . '/../nibeapi/control-engine.php';
+
+$mock = 'http://127.0.0.1:8443';
+$pass = 0; $fail = 0;
+function ok($cond, $label) {
+    global $pass, $fail;
+    if ($cond) { $pass++; echo "  \033[32m✔\033[0m $label\n"; }
+    else { $fail++; echo "  \033[31m✘ $label\033[0m\n"; }
+}
+function section($t) { echo "\n\033[1m$t\033[0m\n"; }
+function mock($path) { global $mock; return file_get_contents($mock . $path); }
+function setRaw($dev, $id, $raw) { mock("/mock/set?device=$dev&id=$id&raw=$raw"); controlClearPointCache(); }
+function rawOf($dev, $id) { controlClearPointCache(); return controlGetPoint($dev, $id)['raw']; }
+function writes() { $f = __DIR__ . '/mock-writes.log'; return is_file($f) ? count(file($f)) : 0; }
+function run($when, $dry = false) {
+    controlClearPointCache();
+    $msgs = [];
+    $r = controlRun(['now' => new DateTime($when), 'dryRun' => $dry, 'log' => function ($m, $t = '') use (&$msgs) { $msgs[] = "$t $m"; }]);
+    $r['msgs'] = $msgs;
+    return $r;
+}
+function ruleState($id) {
+    $s = getDbConnection()->prepare("SELECT letzter_zweig, letzter_wechsel FROM nibe_regeln WHERE id=?");
+    $s->execute([$id]);
+    return $s->fetch();
+}
+
+// ---------------------------------------------------------------- Vorbereitung
+mock('/mock/reset'); mock('/mock/ok');
+ensureExtensionTables();
+$pdo = getDbConnection();
+foreach (['nibe_regel_log', 'nibe_regel_aktionen', 'nibe_regel_bedingungen', 'nibe_regeln', 'nibe_auswahl_punkte', 'nibe_auswahl'] as $t) {
+    $pdo->exec("DELETE FROM $t");
+}
+foreach (discoverDevices() as $d) { saveDevice($d); }
+foreach ([0, 1] as $dev) {
+    $raw = json_decode(fetchApiData(API_BASE_URL . "/api/v1/devices/$dev/points", API_KEY, API_USERNAME, API_PASSWORD), true);
+    saveAllDatapoints(processApiData($raw, $dev), $dev);
+}
+
+// ---------------------------------------------------------------- Zeitfenster
+section('Zeitfenster und Wochentage');
+$mk = fn($von, $bis, $days) => ['wochentage' => $days, 'zeit_von' => $von, 'zeit_bis' => $bis];
+$at = fn($s) => new DateTime($s);   // 2026-11-23 ist ein Montag
+$r = $mk('08:00', '16:00', '1,2,3');
+ok(controlInWindow($r, $at('2026-11-23 08:00')), 'Mo 08:00 liegt im Fenster (Start inklusive)');
+ok(!controlInWindow($r, $at('2026-11-23 16:00')), 'Mo 16:00 liegt nicht mehr im Fenster (Ende exklusive)');
+ok(!controlInWindow($r, $at('2026-11-26 10:00')), 'Do 10:00: Wochentag nicht gewählt');
+$r = $mk('22:00', '06:00', '5');   // nur Freitag
+ok(controlInWindow($r, $at('2026-11-27 23:00')), 'Fr 23:00 liegt im Nachtfenster');
+ok(controlInWindow($r, $at('2026-11-28 02:00')), 'Sa 02:00 gehört noch zum Freitag-Fenster');
+ok(!controlInWindow($r, $at('2026-11-27 02:00')), 'Fr 02:00 gehört zum Donnerstag - nicht gewählt');
+ok(!controlInWindow($r, $at('2026-11-28 23:00')), 'Sa 23:00 nicht gewählt');
+$r = $mk('22:00', '06:00', '7');   // nur Sonntag -> Montag früh gehört dazu
+ok(controlInWindow($r, $at('2026-11-23 03:00')), 'Mo 03:00 gehört zum Sonntag-Fenster (Wochenumbruch)');
+$r = $mk('00:00', '00:00', '1,2,3,4,5,6,7');
+ok(controlInWindow($r, $at('2026-11-26 13:37')), 'von = bis bedeutet ganztägig');
+
+// ---------------------------------------------------------------- Validierung
+section('Eingabe-Validierung');
+$base = ['name' => 'T', 'wochentage' => [1], 'zeit_von' => '08:00', 'zeit_bis' => '09:00',
+         'dann' => [['deviceId' => 1, 'api_id' => 6001, 'wert' => 1]]];
+$expectFail = function ($mod, $label) use ($base) {
+    try { controlValidateRule(array_replace($base, $mod)); ok(false, $label); }
+    catch (Exception $e) { ok(true, $label . '  [' . $e->getMessage() . ']'); }
+};
+$expectFail(['name' => ' '], 'leerer Name wird abgelehnt');
+$expectFail(['wochentage' => []], 'kein Wochentag wird abgelehnt');
+$expectFail(['zeit_von' => '25:00'], 'ungültige Uhrzeit wird abgelehnt');
+$expectFail(['dann' => []], 'ohne DANN-Aktion wird abgelehnt');
+$expectFail(['bedingungen' => [['api_id' => 4, 'operator' => '<', 'vergleichswert' => 'abc']]], 'Vergleichswert muss Zahl sein');
+$expectFail(['bedingungen' => [['api_id' => 4, 'operator' => 'LIKE', 'vergleichswert' => 1]]], 'ungültiger Operator wird abgelehnt');
+$expectFail(['ausserhalb' => 'sonst'], 'ausserhalb=sonst ohne SONST-Aktion wird abgelehnt');
+$expectFail(['dann' => [['api_id' => 6001, 'wert' => 1], ['api_id' => 6001, 'wert' => 2]]], 'doppeltes Ziel im selben Zweig wird abgelehnt');
+$v = controlValidateRule(array_replace($base, ['bedingungen' => [['api_id' => 4, 'operator' => '<', 'vergleichswert' => '-2,5']]]));
+ok($v['bedingungen'][0]['vergleichswert'] === -2.5, 'Dezimalkomma wird akzeptiert (-2,5)');
+$v = controlValidateRule(array_replace($base, ['bedingungen' => [['api_id' => 4, 'operator' => '<', 'vergleichswert' => '1', 'hysterese' => '']]]));
+ok($v['bedingungen'][0]['hysterese'] === 0.0, 'leere Hysterese (Formularfeld) bedeutet 0');
+
+// ---------------------------------------------------------------- Szenario
+section('Szenario: S135 hilft nachts, S2125 läuft allein sobald es reicht');
+// Regel A: Nachts 22-06, alle Tage. WENN GM(S2125) < -200 (Hysterese 50) UND Außen < 0 DANN S135 an SONST S135 aus
+$idA = controlSaveRule(null, [
+    'name' => 'S135 Nachtunterstützung', 'aktiv' => 1, 'prioritaet' => 100,
+    'wochentage' => [1,2,3,4,5,6,7], 'zeit_von' => '22:00', 'zeit_bis' => '06:00',
+    'ausserhalb' => 'sonst', 'min_haltezeit' => 30,
+    'bedingungen' => [
+        ['deviceId' => 0, 'api_id' => 781, 'operator' => '<', 'vergleichswert' => -200, 'hysterese' => 50],
+        ['verknuepfung' => 'UND', 'deviceId' => 0, 'api_id' => 4, 'operator' => '<', 'vergleichswert' => 0],
+    ],
+    'dann'  => [['deviceId' => 1, 'api_id' => 6001, 'wert' => 1]],
+    'sonst' => [['deviceId' => 1, 'api_id' => 6001, 'wert' => 0]],
+]);
+ok($idA > 0, "Regel A angelegt (#$idA)");
+// Anfangszustand: GM -300, Außen -5 °C, S135 aus
+$w0 = writes();
+$r = run('2026-11-25 23:30');   // Mittwoch Nacht
+ok($r['sent'] === 1 && rawOf(1, 6001) === 1, 'Nachts, GM -300 & -5°C: S135 wird eingeschaltet');
+ok(writes() === $w0 + 1, 'genau ein PATCH an die Anlage');
+ok(ruleState($idA)['letzter_zweig'] === 'dann', 'Zustand "dann" gemerkt');
+$q = $pdo->query("SELECT cwna FROM nibe_datenpunkte_log WHERE deviceId=1 ORDER BY id DESC LIMIT 1")->fetchColumn();
+ok($q === 'R', "Werte-Log markiert die Änderung als Regel (cwna='R')");
+
+$r = run('2026-11-25 23:31');
+ok($r['sent'] === 0 && writes() === $w0 + 1, 'Minute später: Wert stimmt schon -> es wird NICHT erneut gesendet');
+
+setRaw(0, 781, -1800);   // GM -180: ohne Hysterese wäre "falsch", mit Hysterese (< -150) bleibt es wahr
+$r = run('2026-11-25 23:45');
+ok(rawOf(1, 6001) === 1 && $r['sent'] === 0, 'GM -180: Hysterese hält S135 an (kein Flattern)');
+
+setRaw(0, 781, -1000);   // GM -100: Bedingung falsch -> SONST, aber Mindest-Haltezeit 30 min seit 23:30
+$r = run('2026-11-25 23:50');
+ok(rawOf(1, 6001) === 1 && $r['sent'] === 0, 'GM -100 um 23:50: Mindest-Haltezeit (bis 00:00) verhindert das Abschalten');
+$r = run('2026-11-26 00:10');   // Donnerstag früh, Fenster von Mittwoch
+ok(rawOf(1, 6001) === 0 && $r['sent'] === 1, 'GM -100 um 00:10: Haltezeit vorbei, S135 wird abgeschaltet');
+ok(ruleState($idA)['letzter_zweig'] === 'sonst', 'Zustand "sonst" gemerkt');
+
+// Zwischen -150 und -200 (nicht holding): GM -170 -> bleibt SONST (Hysterese gilt nur im DANN-Zweig)
+setRaw(0, 781, -1700);
+$r = run('2026-11-26 01:00');
+ok(rawOf(1, 6001) === 0, 'GM -170 im SONST-Zustand: kein Einschalten (Schwelle -200 gilt)');
+
+// Wieder schlechter -> an, danach tagsüber (außerhalb) -> SONST wegen ausserhalb=sonst
+setRaw(0, 781, -2600);
+$r = run('2026-11-26 02:00');
+ok(rawOf(1, 6001) === 1, 'GM -260 um 02:00: S135 wieder an');
+$r = run('2026-11-26 07:00');
+ok(rawOf(1, 6001) === 0, 'Außerhalb des Zeitfensters (07:00): SONST-Aktion schaltet S135 ab');
+
+// Wärmer: Außentemperatur +3 °C -> UND-Bedingung falsch trotz tiefer GM
+setRaw(0, 4, 30);
+$r = run('2026-11-26 23:00');
+ok(rawOf(1, 6001) === 0, 'UND: Außen +3°C verhindert das Einschalten trotz GM -260');
+setRaw(0, 4, -50);
+
+// ---------------------------------------------------------------- Ausfall
+section('Sicherheit bei Ausfall');
+$st = ruleState($idA);
+$w = writes();
+setRaw(0, 781, -2600);
+mock('/mock/fail?device=0');
+controlClearPointCache();
+$r = run('2026-11-27 23:00');
+ok(writes() === $w && $r['sent'] === 0, 'Device 0 offline: Bedingung unbekannt -> es wird nichts gesendet');
+ok(ruleState($idA)['letzter_zweig'] === $st['letzter_zweig'], 'Gemerkter Zustand bleibt bei Ausfall unverändert');
+mock('/mock/ok');
+$r = run('2026-11-27 23:01');
+ok(rawOf(1, 6001) === 1, 'Device wieder online: Regel greift wieder');
+
+// ---------------------------------------------------------------- Drosselung
+section('Drosselung gegen Dauer-Senden');
+setRaw(1, 6001, 0);   // Anlage setzt den Wert zurück
+$w = writes();
+$r = run('2026-11-27 23:05');
+ok($r['throttled'] === 1 && writes() === $w, 'Wert 5 Min nach dem Senden zurückgesetzt: nicht sofort erneut senden');
+$r = run('2026-11-27 23:15');
+ok($r['sent'] === 1 && rawOf(1, 6001) === 1, 'Nach 10 Minuten: erneuter Versuch');
+
+// ---------------------------------------------------------------- Priorität
+section('Priorität bei Konflikt');
+$idB = controlSaveRule(null, [
+    'name' => 'S135 Sperre (wichtiger)', 'aktiv' => 1, 'prioritaet' => 10,
+    'wochentage' => [1,2,3,4,5,6,7], 'zeit_von' => '00:00', 'zeit_bis' => '00:00',
+    'dann' => [['deviceId' => 1, 'api_id' => 6001, 'wert' => 0]],
+]);
+$r = run('2026-11-27 23:30');
+ok(rawOf(1, 6001) === 0, 'Regel mit höherer Priorität (10) gewinnt gegen Regel A (100)');
+ok($r['overridden'] === 1, 'Regel A wird als übersteuert gemeldet');
+controlSetRuleActive($idB, false);
+
+// ---------------------------------------------------------------- Dry-Run, Bereich, Mehrfach
+section('Dry-Run, Wertebereich, ODER');
+setRaw(1, 6001, 0); setRaw(0, 781, -2600);
+$w = writes();
+$r = run('2026-11-28 23:00', true);
+ok(writes() === $w && rawOf(1, 6001) === 0, 'Dry-Run sendet nichts');
+
+$idC = controlSaveRule(null, [
+    'name' => 'Heizkurve zu hoch', 'aktiv' => 1, 'prioritaet' => 50,
+    'wochentage' => [1,2,3,4,5,6,7], 'zeit_von' => '00:00', 'zeit_bis' => '00:00',
+    'dann' => [['deviceId' => 0, 'api_id' => 5002, 'wert' => 99]],   // erlaubt: 1..15
+]);
+$r = run('2026-11-28 12:00');
+ok(rawOf(0, 5002) === 7 && $r['errors'] >= 1, 'Zielwert außerhalb 1..15 wird abgelehnt, nichts gesendet');
+$logged = $pdo->query("SELECT COUNT(*) FROM nibe_regel_log WHERE regel_id=$idC AND status='fehler'")->fetchColumn();
+$r = run('2026-11-28 12:01');
+$logged2 = $pdo->query("SELECT COUNT(*) FROM nibe_regel_log WHERE regel_id=$idC AND status='fehler'")->fetchColumn();
+ok($logged == 1 && $logged2 == 1, 'derselbe Fehler wird nicht jede Minute neu protokolliert');
+controlSetRuleActive($idC, false);
+
+$idD = controlSaveRule(null, [
+    'name' => 'ODER-Test', 'aktiv' => 1, 'prioritaet' => 60,
+    'wochentage' => [1,2,3,4,5,6,7], 'zeit_von' => '00:00', 'zeit_bis' => '00:00',
+    'bedingungen' => [
+        ['deviceId' => 0, 'api_id' => 4, 'operator' => '>', 'vergleichswert' => 20],            // falsch (-5)
+        ['verknuepfung' => 'ODER', 'deviceId' => 0, 'api_id' => 781, 'operator' => '<=', 'vergleichswert' => -100],  // wahr
